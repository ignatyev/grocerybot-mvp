{
  "manifest_version": 3,
  "name": "GroceryBot — цены из моего Chrome",
  "version": "0.6.0",
  "description": "Поиск товаров и чтение видимых цен в авторизованных вкладках. Поддерживает обучение маршруту поиска и локальную диагностику, не передаёт cookies или пароли.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://grocerybot-web-production.up.railway.app/*",
    "https://magnit.ru/*",
    "https://*.magnit.ru/*",
    "https://5ka.ru/*",
    "https://*.5ka.ru/*",
    "https://perekrestok.ru/*",
    "https://*.perekrestok.ru/*",
    "https://vkusvill.ru/*",
    "https://*.vkusvill.ru/*",
    "https://kuper.ru/*",
    "https://*.kuper.ru/*",
    "https://eda.yandex.ru/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
